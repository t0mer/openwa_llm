WHATSAPP_HOST=http://localhost:2785
OPENWA_API_KEY=change-me-long-random-string
OPENWA_SESSION_ID=your-openwa-session-id
OPENWA_WEBHOOK_SECRET=at-least-16-random-characters
OPENWA_WEBHOOK_URL=http://host.docker.internal:8000/webhook
VOYAGE_API_KEY=your_voyage_api_key
DB_URI=postgresql+asyncpg://user:password@localhost:5432/postgres
LOG_LEVEL=INFO
ANTHROPIC_API_KEY=your-key-here
LOGFIRE_TOKEN=your-key-here

# Do NOT wrap these lists in quotes, as that may cause JSON parsing errors in some environments (Docker/Linux).
QA_TESTERS=["2501234567@s.whatsapp.net", "1543210987@s.whatsapp.net"]
QA_TEST_GROUPS=["132456@g.us"]

# Admin UI (served at /admin). DISABLED unless BOTH ADMIN_PASSWORD and ADMIN_SESSION_SECRET are set.
# Choose your own password and generate the secret (>= 32 chars), e.g.:  openssl rand -hex 32
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=
# Set to true when the UI is served over HTTPS (recommended in production, e.g. behind a TLS reverse proxy).
ADMIN_COOKIE_SECURE=false
